{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lex Studio",
  "mainBinaryName": "lex-studio",
  "version": "0.1.0",
  "identifier": "com.studiofamily.lexstudio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lex Studio",
        "width": 430,
        "height": 600,
        "minWidth": 340,
        "minHeight": 320,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Pop-up dictionary for translating",
    "longDescription": "A small pop-up dictionary for translating: a key combination brings it up at the mouse pointer with the copied word already looked up. Latin, Ancient Greek, English, German, French, Spanish, Russian, Italian, Swedish and Japanese, from Wiktionary; answers are kept for offline use.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
